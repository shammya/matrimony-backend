# Copy to .env; never commit real credentials. Node 24.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Runtime and migration roles are intentionally separate.
DATABASE_URL=postgresql://matrimony_app:local_app_password@127.0.0.1:5432/matrimony
MIGRATION_DATABASE_URL=postgresql://postgres:local_admin_password@127.0.0.1:5432/matrimony
DB_SSL=disable
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DATABASE=matrimony_events
MONGO_POOL_MAX=5
REDIS_URL=redis://127.0.0.1:6379
IO_TIMEOUT_MS=5000
TENANT_HOSTS={"localhost":"11111111-1111-4111-8111-111111111111"}
# A real provider must support HTTPS discovery, S256 PKCE, JWT API access tokens,
# rotating refresh tokens, and revocation. Register the exact callback URL.
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=matrimony-backend
OIDC_CLIENT_SECRET=configure-provider-secret
OIDC_AUDIENCE=matrimony-api
OIDC_SCOPE=openid offline_access matrimony:api
OIDC_REQUIRED_SCOPE=matrimony:api
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=28800
WORKER_POLL_MS=1000
EVENT_MAX_ATTEMPTS=12
