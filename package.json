{
  "name": "matrimony-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "auth:keygen": "tsx scripts/auth-keygen.ts",
    "auth:set-password": "tsx --env-file=.env scripts/set-password.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src scripts test *.json *.js .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
